{
  "name": "tro-and-lam-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "fondend",
    "backend"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -k -n web,api \"npm run dev -w fondend\" \"npm run dev -w backend\"",
    "dev:web": "npm run dev -w fondend",
    "dev:api": "npm run dev -w backend",
    "build": "npm run build -w fondend",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test": "npm test -w backend",
    "test:e2e": "node node_modules/@playwright/test/cli.js test --config tests/e2e/playwright.config.js",
    "validate:contracts": "node scripts/validate-contracts.js",
    "check": "npm run validate:contracts && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.63.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "9.2.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "concurrently": {
      "shell-quote": "1.12.0"
    }
  }
}
