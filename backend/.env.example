NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/tro_lam?retryWrites=true&w=majority
# Comma-separated exact HTTP(S) origins; keep localhost for Vite development.
CORS_ORIGIN=http://localhost:5173
# Keep 0 locally. Set 1 on Render behind one trusted reverse proxy.
TRUST_PROXY=0
# Optional in development (a process-ephemeral key is generated when empty); required in production.
CSRF_SECRET=
# Public site origin used to build account verification/reset/invitation links.
PUBLIC_WEB_URL=http://localhost:5173
SESSION_COOKIE_NAME=tl_session
RESTRICTED_COOKIE_NAME=tl_appeal
GUEST_ORDER_COOKIE_NAME=tl_guest_order
CSRF_COOKIE_NAME=tl_csrf
COOKIE_PATH=/api/v1
COOKIE_SAME_SITE=Lax
SECURE_COOKIES=false
