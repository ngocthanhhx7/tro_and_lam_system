NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/tro_lam?retryWrites=true&w=majority
# Comma-separated exact HTTP(S) origins; keep localhost for Vite development.
CORS_ORIGIN=http://localhost:5173
# Keep 0 locally. Set 1 on Render behind one trusted reverse proxy.
TRUST_PROXY=0
# Optional in development (a process-ephemeral key is generated when empty); required in production.
CSRF_SECRET=
# Public site origin used to build account verification/reset/invitation links.
PUBLIC_WEB_URL=http://localhost:5173
SESSION_COOKIE_NAME=tl_session
RESTRICTED_COOKIE_NAME=tl_appeal
GUEST_ORDER_COOKIE_NAME=tl_guest_order
CSRF_COOKIE_NAME=tl_csrf
COOKIE_PATH=/api/v1
COOKIE_SAME_SITE=Lax
SECURE_COOKIES=false
# Stable Base64 encoding of 32 random bytes. Required in production to decrypt queued mail after restarts.
OUTBOX_ENCRYPTION_KEY=
# SMTP is optional in local development. Set all five values to enable real outbound mail.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_MS=15000
SUPPORT_INBOX_EMAIL=
# PayOS remains unavailable unless enabled and all merchant credentials are set server-side.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_TIMEOUT_MS=10000
# Gemini is disabled when key/model/budget is missing. The model must be supported by Google's API.
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT_MS=10000
AI_DAILY_BUDGET=0
RESERVATION_SWEEP_INTERVAL_MS=30000
PAYMENT_RECONCILIATION_INTERVAL_MS=60000
# Set false on a web-only process when a separate `node src/worker.js` process runs the jobs.
BACKGROUND_WORKERS_ENABLED=true
