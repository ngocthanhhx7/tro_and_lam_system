# Edit /opt/tro-lam/current/backend/.env on the VPS.
NODE_ENV=production
PORT=5000
LISTEN_HOST=127.0.0.1
# Required: enter your MongoDB Atlas URI, including the database name.
# Allow the VPS IP 3.26.8.132/32 in Atlas Network Access.
MONGODB_URI=
CORS_ORIGIN=https://trovalam.vn,https://www.trovalam.vn
TRUST_PROXY=1
PUBLIC_WEB_URL=https://trovalam.vn
# Generated once on first installation; keep these stable across deployments.
CSRF_SECRET=
OUTBOX_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=tl_session
RESTRICTED_COOKIE_NAME=tl_appeal
GUEST_ORDER_COOKIE_NAME=tl_guest_order
CSRF_COOKIE_NAME=tl_csrf
COOKIE_PATH=/api/v1
COOKIE_SAME_SITE=Lax
SECURE_COOKIES=true
# Optional email provider: fill all required SMTP fields together.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_MS=15000
SUPPORT_INBOX_EMAIL=
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_TIMEOUT_MS=10000
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT_MS=10000
AI_DAILY_BUDGET=0
BACKGROUND_WORKERS_ENABLED=true
RESERVATION_SWEEP_INTERVAL_MS=30000
PAYMENT_RECONCILIATION_INTERVAL_MS=60000
# Current application does not yet have a production media provider.
# Do not switch to local or development to bypass production validation.
MEDIA_STORAGE_DRIVER=disabled
MEDIA_PUBLIC_BASE_URL=
SUPPORT_STORAGE_DRIVER=disabled
